# Local Ollama endpoint (must remain localhost / 127.0.0.1)
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
VLM_MODEL=qwen2.5vl:7b

# Local HuggingFace model identifiers (resolved from local cache only)
EMBED_MODEL=BAAI/bge-m3
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Local Audit Console HTTP server port
CERBERUS_LANDING_PORT=8503
